{
  "name": "fastify-ocpp",
  "version": "1.0.0",
  "description": "Fastify WebSocket OCPP CSMS for 1.6, 2.0.1 and 2.1 with shared-path subprotocol negotiation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch examples/server.ts",
    "example": "tsx examples/server.ts",
    "prepublishOnly": "npm run build",
    "smoke": "tsx examples/smoke-test.ts"
  },
  "keywords": [
    "ocpp",
    "ocpp1.6",
    "ocpp2.0.1",
    "ocpp2.1",
    "fastify",
    "websocket",
    "evse",
    "charging"
  ],
  "author": "Mateus M. Côrtes",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/mateuslacorte/fastify-ocpp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mateuslacorte/fastify-ocpp.git"
  },
  "bugs": {
    "url": "https://github.com/mateuslacorte/fastify-ocpp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.0.0",
    "fastify-plugin": "^6.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  }
}
